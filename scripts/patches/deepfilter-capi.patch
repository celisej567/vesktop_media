+/// vesktop_media: set the local SNR thresholds of the processing stages (dB). Below `min_db` the frame is treated as
+/// noise only (zero mask); above `max_db_erb` no processing runs at all; above `max_db_df` the deep filter stage is
+/// skipped. With a clean microphone the local SNR hovers around the upper thresholds and the stages switch on and
+/// off from frame to frame, which is audible as a pulsing voice.
+#[no_mangle]
+pub unsafe extern "C" fn df_set_thresholds(st: *mut DFState, min_db: f32, max_db_erb: f32, max_db_df: f32) {
+    let Some(state) = st.as_mut() else { return };
+    state.0.min_db_thresh = min_db;
+    state.0.max_db_erb_thresh = max_db_erb;
+    state.0.max_db_df_thresh = max_db_df;
+}
